<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TripWay.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - TripWay</title>
    <script src="<%= ResolveUrl("~/Scripts/tailwind.js") %>"></script>
    <style>
        /* ---- one type family ------------------------------------------------ */
        /* Every page inherits this from the one place. It is the same stack
           Tailwind's preflight already applies, so pinning it here changes no
           existing text; it just stops any page quietly reaching for a second
           family. */
        html, body {
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
                         "Helvetica Neue", Arial, "Noto Sans", sans-serif,
                         "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol",
                         "Noto Color Emoji";
        }
        /* leaflet.css is linked from inside the page body, so it lands after this
           block and a rule of equal specificity would lose to it. The body prefix
           is what makes these win. */
        body .leaflet-container { font-family: inherit; }

        /* ---- surfaces ------------------------------------------------------ */
        .tw-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 1rem;
            padding: 1.375rem;
        }
        .tw-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.125rem 0.5rem;
            border-radius: 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            white-space: nowrap;
        }

        /* ---- buttons ------------------------------------------------------- */
        .tw-btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.125rem;
            border-radius: 0.5rem;
            background: #2563eb;
            color: #fff;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
        }
        .tw-btn-primary:hover { background: #1d4ed8; }
        .tw-btn-primary:focus-visible { outline: 2px solid #93c5fd; outline-offset: 2px; }

        .tw-btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.125rem;
            border-radius: 0.5rem;
            background: #f3f4f6;
            color: #111827;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .15s;
        }
        .tw-btn-secondary:hover { background: #e5e7eb; }

        .tw-btn-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            background: #fff;
            color: #374151;
            font-size: 0.8125rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: background .15s;
        }
        /* Hover lights the icon and leaves everything else alone: the label keeps its
           colour and the border stays the grey it already had, so the button reads as
           unlit until the pointer is on it. */
        .tw-btn-outline:hover { background: #f3f4f6; }
        .tw-btn-outline:hover svg { color: #2563eb; }
        .tw-btn-outline svg { transition: color .15s; }

        /* Sits after .tw-btn-outline on purpose: these carry the same specificity, so being
           later is what lets the red hover win. Paired with tw-btn-outline, this used to
           be permanently red, which meant it read as "already active" rather than
           "destructive" - red now only arrives on hover. */
        .tw-btn-soft-danger {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.75rem;
            border-radius: 0.5rem;
            background: #fff;
            border-color: #e5e7eb;
            color: #374151;
            font-size: 0.8125rem;
            font-weight: 500;
            cursor: pointer;
        }
        .tw-btn-soft-danger:hover { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
        .tw-btn-soft-danger:hover svg { color: #dc2626; }

        /* ---- row actions --------------------------------------------------- */
        /* Icon-only square, same shape as JobConnect's .jc-action. These were bare blue text
           links with no border or background, so the action column read as a run of plain
           links instead of a row of buttons. Verified every .tw-action in the project holds
           only an svg, which is what makes the fixed 2rem box safe here. */
        .tw-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            background: #fff;
            color: #6b7280;
            cursor: pointer;
            text-decoration: none;
            flex-shrink: 0;
            line-height: 1;
            transition: background .15s, color .15s, border-color .15s;
        }
        .tw-action:hover { background: #f3f4f6; color: #111827; }
        /* Destructive stays grey until hover rather than copying JobConnect's red-at-rest,
           to match the hover-only-red rule already used for .tw-btn-soft-danger. */
        .tw-action-danger:hover { background: #fef2f2; border-color: #fecaca; color: #dc2626; }
        .tw-action-success:hover { background: #ecfdf5; border-color: #bbf7d0; color: #059669; }

        /* ---- tables -------------------------------------------------------- */
        .tw-table-wrap { overflow-x: auto; }
        .tw-table { width: 100%; border-collapse: collapse; }
        .tw-table th {
            background: #f9fafb;
            color: #6b7280;
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 0.75rem 1.25rem;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }
        .tw-table td {
            padding: 0.875rem 1.25rem;
            font-size: 0.875rem;
            color: #111827;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }
        .tw-table tbody tr:hover { background: #f9fafb; }
        /* Sortable column header: two chevrons stacked beside the label, one click each
           for up and down. They sit grey at rest, take the accent on hover, and the one
           currently sorting stays lit so the direction is readable at a glance. */
        .tw-sort {
            display: inline-flex;
            flex-direction: column;
            align-items: stretch;
            line-height: 0;
            vertical-align: middle;
            user-select: none;
        }
        .tw-sort .tw-sort-arrow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #9ca3af;
            border-radius: 0.25rem;
            padding: 0.125rem;
            cursor: pointer;
            line-height: 0;
            text-decoration: none;
            transition: color .15s, background .15s;
        }
        .tw-sort .tw-sort-arrow:hover { color: #2563eb; background: #eff6ff; }
        .tw-sort .tw-sort-arrow.active { color: #007aff; background: #eff6ff; }
        .tw-sort .tw-sort-arrow svg { width: 0.7rem; height: 0.7rem; }

        .tw-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 9999px;
            font-weight: 600;
            font-size: 0.85rem;
            flex-shrink: 0;
        }
        .tw-avatar-blue { background: #dbeafe; color: #1d4ed8; }
        .tw-avatar-green { background: #d1fae5; color: #047857; }
        .tw-avatar-amber { background: #fef3c7; color: #b45309; }
        /* GetAvatarCss picks from blue/green/violet/amber by hashing the row id, but violet
           was never given a rule - so one row in four rendered with no background at all
           and inherited text colour. Matches JobConnect's .jc-avatar-violet. */
        .tw-avatar-violet { background: #f5f3ff; color: #7c3aed; }
        /* The initials circle that stands in for a missing photo has to be exactly the
           size of the photo it replaces, or the row jumps when a photo is absent. The
           photos are size-10 (2.5rem) plus a ring on the management pages and a border on
           the trip history pages, while .tw-avatar was 2.25rem with neither - 4px smaller
           and missing the ring, which is what made the fallback look like a different
           control. Kept as its own class rather than resizing .tw-avatar, because the
           size-14 and size-8 avatars rely on Tailwind winning that one. */
        .tw-avatar-photo { width: 2.5rem; height: 2.5rem; box-shadow: 0 0 0 2px #f3f4f6; }
        .tw-avatar-photo-border { box-shadow: none; border: 1px solid #f1f5f9; }

        /* The same 2.5rem circle, for a real photograph rather than a letter. Kept apart
           from .tw-avatar because that one is inline-flex to centre a letter inside itself,
           and an <img> given a flex display stops being a plain replaced box: the picture
           becomes a flex item and a logo wider than it is tall no longer fills the circle.
           This one only describes the box, so object-fit on the img does what it says. */
        .tw-avatar-img {
            display: block;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 9999px;
            flex-shrink: 0;
        }

        /* ---- skeletons ------------------------------------------------------
           What stands in when a slot has no image. It has to hold the exact box the
           image would have taken, or every card and row jumps the moment a photo is
           missing, so the ratio lives here instead of being left to each page:
           media (package photos, document thumbnails, gallery tiles) is 4:3 and
           avatars are 1:1. Only the ratio is set - width and height still come from
           the Tailwind size-* class on the element, which is how one rule covers the
           size-8, size-10 and size-14 avatars. The pulse is defined here rather than
           leaning on Tailwind's animate-pulse so a slot keeps working even if the
           class is never seen by the CDN's scanner. */
        .tw-skeleton { background: #e2e8f0; animation: tw-skeleton-pulse 1.6s ease-in-out infinite; }
        .tw-skeleton-media { aspect-ratio: 4 / 3; }
        .tw-skeleton-avatar { aspect-ratio: 1 / 1; border-radius: 9999px; }
        @keyframes tw-skeleton-pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.55; }
        }

        /* ---- inputs -------------------------------------------------------- */
        .tw-input {
            display: block;
            width: 100%;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            padding: 0.5rem 0.875rem;
            font-size: 0.875rem;
            color: #111827;
            background: #fff;
        }
        /* The filter dropdowns are sized w-auto, which sets them to the intrinsic width of
           their widest option - but they sit in a flex row, where the default flex-shrink:1
           still let the toolbar squeeze them until the option text was cut off. Letting the
           drop arrow keep its own room on the right is what stops the text running under it.
           ddlPerPage keeps its own !px-2.5 override, so it stays compact. */
        select.tw-input {
            flex-shrink: 0;
            padding-right: 2rem;
        }
        .tw-input:focus {
            outline: none;
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }
        .tw-textarea { min-height: 6rem; resize: vertical; }
        /* Read-only values on the admin detail pages. No tinted background: the value sits
           under a bold label on a white card, so a grey panel behind each one made every
           field look selected rather than simply not editable. Kept for the two things that
           still matter here, which is the colour and wrapping a long value. */
        .tw-readonly { color: #111827; overflow-wrap: anywhere; }

        /* ---- detail pages -------------------------------------------------- */
        .tw-detail-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
        .tw-detail-label { color: #9ca3af; font-weight: 600; font-size: 0.75rem; }
        .tw-detail-value { color: #111827; font-size: 0.875rem; overflow-wrap: anywhere; }

        .tw-empty {
            padding: 3rem 1rem;
            text-align: center;
            color: #9ca3af;
            font-size: 0.875rem;
        }

        /* ---- paging -------------------------------------------------------- */
        /* space-between is what pushes the "Showing 1-6 of 6" note to the left edge and
           the prev/number/next cluster to the right edge; without it the two just sit
           next to each other at the left. flex-wrap keeps them usable when narrow. */
        .tw-pager { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
        .tw-pager-info { color: #6b7280; font-size: .8125rem; }
        .tw-pager-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 2.125rem;
            height: 2.125rem;
            padding: 0 0.875rem;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            background: #fff;
            color: #374151;
            font-size: 0.8125rem;
            font-weight: 500;
            line-height: 1;
            cursor: pointer;
            text-decoration: none;
            transition: background .15s, border-color .15s, color .15s;
        }
        .tw-pager-btn svg { transition: color .15s; }
        /* Same rule as the sort arrows: grey until the pointer is on it, accent on hover. */
        .tw-pager-btn:hover:not(:disabled):not(.active) { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; }
        .tw-pager-btn:hover:not(:disabled):not(.active) svg { color: #2563eb; }
        .tw-pager-btn:disabled { opacity: .45; cursor: not-allowed; }
        /* The current page is the one button that stays lit, otherwise there is no way to
           tell where you are in the list. */
        .tw-pager-btn.active,
        .tw-pager-btn.active:hover { background: #2563eb; border-color: #2563eb; color: #fff; }
        .tw-pager-btn.active:hover svg { color: #fff; }

        /* ---- misc ---------------------------------------------------------- */
        .tw-file { font-size: .8125rem; color: #6b7280; }
        .tw-cta-banner { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 1rem; padding: 1.25rem; }
        .tw-cover { width: 100%; height: 100%; object-fit: cover; }
        .tw-stars { color: #f59e0b; letter-spacing: .1em; }
        .tw-hint { color: #9ca3af; font-size: .75rem; }
        .tw-name { color: #111827; font-weight: 600; }
        .tw-fallback { background: #f3f4f6; color: #9ca3af; }
        .tw-preview, .tw-preview-tile { border: 1px solid #e5e7eb; border-radius: .5rem; overflow: hidden; }
        .tw-share-preview { max-width: 20rem; }

        /* ---- payment picker ----------------------------------------------- */
        /* A segmented row rather than three cards: the summary panel beside it is tall, and
           three 2rem-bordered cards pushed the total estimate off screen. */
        .tw-pay-seg {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .25rem;
            padding: .4375rem .25rem;
            border-radius: .5rem;
            font-size: .6875rem;
            font-weight: 600;
            line-height: 1;
            color: #64748b;
            background: transparent;
            cursor: pointer;
            transition: background .15s, color .15s, box-shadow .15s;
        }
        .tw-pay-seg:hover { color: #1d4ed8; }
        .tw-pay-seg:focus-visible { outline: 2px solid #2563eb; outline-offset: 1px; }
        .tw-pay-seg.is-active {
            background: #2563eb;
            color: #fff;
            box-shadow: 0 1px 2px rgba(0, 0, 0, .14);
        }
        /* The logos are JPEGs and PNGs of unknown background, so each sits on its own white
           chip. Without it an opaque logo on a blue segment can disappear into it. */
        .tw-pay-logo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 1.25rem;
            height: 1.25rem;
            padding: .1875rem;
            border-radius: .375rem;
            background: #fff;
            flex: none;
        }
        .tw-pay-logo img { max-width: 100%; max-height: 100%; }
        .tw-pay-logo img[style*="visibility:hidden"] { visibility: hidden; }

        /* Payment-method icon beside the label on the five trip-detail pages. Unrelated to the
           picker above, and still used: Admin/TripDetail, Customer/TripDetail,
           Driver/ActiveTrip, Driver/RequestDetail and Driver/TripDetail. */
        .tw-pay-badge {
            position: relative;
            display: inline-block;
            width: 1.25rem;
            height: 1.25rem;
            padding: .1875rem;
            border-radius: .375rem;
            background: #fff;
            border: 1px solid #e2e8f0;
            object-fit: contain;
            vertical-align: middle;
        }

        /* ---- chat ---------------------------------------------------------- */
        .tw-msg { max-width: 75%; padding: .625rem .875rem; border-radius: 1rem; font-size: .875rem; }
        .tw-msg-me { background: #2563eb; color: #fff; margin-left: auto; }
        .tw-msg-them { background: #f3f4f6; color: #111827; border-bottom-left-radius: 0.125rem; }

        /* ---- toasts -------------------------------------------------------- */
        /* No rule for [data-tw-toast] any more.
           These server panels used to be positioned here in the bottom right corner, which
           fought the real toast stack: that one is injected by tw-toast.js into the top right.
           A message coming from a server panel therefore painted twice, as two unrelated
           toasts in two corners. tw-toast.js now parks the panel with tw-panel-parked as soon
           as it has lifted the text, so the panel never shows and only the toast does.

           With no rule of their own the panels also fall back to rendering inline in the spot
           the page declared, which is what should happen if tw-toast.js fails to load at all:
           the message is still readable rather than stranded in a corner of its own. */

        /* A server panel meant to be shown in the lightbox stays hidden until it is moved.
           The server renders it with this class so nothing flashes in its declared spot. */
        .tw-panel-parked { display: none !important; }

        /* The panel sits in the middle of the screen, both ways.
           Auto margins rather than align-items: center, because centering a flex item that
           is taller than the screen puts its top out of reach of the scroll, and a form with
           a validation message down the bottom is often taller than a laptop screen. Auto
           margins collapse to nothing when there is no free space, so the panel starts at the
           top and scrolls normally, and lands dead centre when there is room. */
        #appModal > div { margin: auto; }

        /* Pinned to the top right of the browser window rather than to the corner of the
           card. Fixed rather than absolute, so it stays put when the panel is centred and no
           longer hangs off the card, which is what put half of it outside the white.
           Above the panel it shares a parent with: both are positioned with an automatic
           z-index, so the one later in the markup would otherwise paint over the button. */
        .tw-lb-close {
            position: fixed;
            z-index: 20;
            top: 0.75rem;
            right: 0.75rem;
            width: 2.5rem;
            height: 2.5rem;
            /* Always drawn white now: sitting on the backdrop in the corner of the window
               rather than on the card, a near-black cross disappeared into it. The drop
               shadow keeps it readable over a pale page without putting a plate behind it. */
            background: none;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.55));
        }

        /* Image viewer. A photograph or document is shown in an ordinary modal card rather
           than edge to edge: the white card, its rounded corners and the backdrop are kept,
           and only the body padding is trimmed so the picture sits close to the frame. The
           centring is inherited from the margin: auto above rather than restated as
           align-items: center, so a document taller than the screen still starts at the top
           and scrolls instead of having its head cut off. Only present while an image is
           open, so every other overlay keeps the card it was designed around. */
        #appModal.tw-modal-image #appModalBody { padding: 0.75rem; }
        #appModal.tw-modal-image .tw-lb-close {
            /* Back on the card instead of the window corner. Pinned to the screen it floated
               far away from a panel this size, and drawn white on its own it disappeared into
               the white card, so it gets a plate to sit on and loses the drop shadow it only
               needed in order to read against an open backdrop. */
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background: rgba(17, 24, 39, 0.55);
            border-radius: 9999px;
            filter: none;
        }
        @media (max-width: 640px) {
            .tw-detail-grid { grid-template-columns: 1fr; }
            .tw-table th, .tw-table td { padding-left: 1rem; padding-right: 1rem; }
        }

        /* Active public nav link: brand blue text with an underline, matching the
           JobConnect header. The class is applied on the server by
           rptPublicNav_ItemDataBound. Blue matches .tw-btn-primary above. */
        #publicNav a.tw-nav-active,
        #publicMobileNav a.tw-nav-active {
            position: relative;
            color: #2563eb !important;
            font-weight: 600;
            text-decoration: none;
        }
        #publicNav a.tw-nav-active::after,
        #publicMobileNav a.tw-nav-active::after {
            content: '';
            position: absolute;
            left: 12px;
            right: 12px;
            bottom: 1px;
            height: 2px;
            border-radius: 9999px;
            background: #2563eb;
        }

        /* ---- header profile block ---------------------------------------------
           Site.master.cs emits these five class names for the signed in user in the
           app header. They had no rule anywhere, so .profile-avatar on an <img> fell
           back to the image's intrinsic size and the header grew to fit the uploaded
           photo, with the name and email spilling out beside it unstyled. */
        .header-profile-container { display: flex; align-items: center; gap: 10px; }
        .profile-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
        .profile-info { display: flex; flex-direction: column; line-height: 1.3; }
        .profile-name { font-weight: 600; font-size: 0.8125rem; color: #111827; }
        .profile-email { font-size: 0.6875rem; color: #9ca3af; }

        /* ---- collapsible app sidebar ---------------------------------------
           The rail is laid out at every width and the toggle narrows it to an
           icon-only column. Hiding it outright below a breakpoint, as this did
           with "hidden lg:flex", left a narrow window with no way to the nav at
           all, because there was no mobile fallback for it. */
        #sideNav { width: 18rem; }
        #sideNav.tw-collapsed { width: 4rem; }
        #sideNav .nav-item { width: 100%; }
        #sideNav .lnk-logout { width: 100%; }
        /* The pending pill carries nav-label too, so collapsing the rail drops
           it along with the text instead of cramming a number into 4rem. */
        #sideNav.tw-collapsed .nav-label,
        #sideNav.tw-collapsed .side-title,
        #sideNav.tw-collapsed .side-brand-text { display: none; }
        #sideNav.tw-collapsed .nav-item,
        #sideNav.tw-collapsed .side-head,
        #sideNav.tw-collapsed .lnk-logout {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }
        /* Both toggle glyphs sit in the markup and CSS picks which one shows, off the
           same class that drives the width. Nothing has to be rebuilt in script. */
        #sideNav .side-toggle-collapsed { display: none; }
        #sideNav.tw-collapsed .side-toggle-expanded { display: none; }
        #sideNav.tw-collapsed .side-toggle-collapsed { display: inline-block; }
    </style>
</head>
<body class="bg-white text-gray-900">
    <form id="form1" runat="server">
        <div id="appShell" runat="server" class="min-h-screen">

            <%-- Public header: shown on the marketing and auth pages. Follows the JobConnect
                 layout: sticky bar, brand block with a tagline, page links with an
                 active underline, and the auth buttons kept outside the collapsing
                 nav so they survive at every width. --%>
            <asp:Panel ID="pnlPublicHeader" runat="server" Visible="false">
                <nav class="sticky top-0 z-40 bg-white text-gray-900 shadow-sm border-b border-gray-200">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6">
                        <div class="flex items-center justify-between h-16">
                            <a href="<%= ResolveUrl("~/Default.aspx") %>" class="flex items-center gap-2.5" aria-label="TripWay home">
                                <img src="<%= ResolveUrl("~/Images/logo.jpeg") %>" alt="TripWay logo" class="size-10 rounded-xl object-contain shrink-0" />
                                <span class="leading-tight">
                                    <span class="font-bold text-[15px] text-gray-900 leading-tight">TripWay</span>
                                    <span class="block text-[11px] text-gray-400 leading-tight">Transport Platform</span>
                                </span>
                            </a>

                            <div id="publicNav" class="hidden md:flex items-center gap-1 text-sm font-medium">
                                <asp:Repeater ID="rptPublicNav" runat="server" OnItemDataBound="rptPublicNav_ItemDataBound">
                                    <ItemTemplate>
                                        <a id="publicNavLink" runat="server" href='<%# Eval("Url") %>'
                                           class="px-3 py-2 rounded-md text-gray-700 hover:text-blue-600 transition-colors"><%# Eval("Text") %></a>
                                    </ItemTemplate>
                                </asp:Repeater>
                            </div>

                            <div class="flex items-center gap-2.5">
                                <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx"
                                    CssClass="hidden sm:inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-gray-700 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors">
                                    Login
                                </asp:HyperLink>
                                <asp:HyperLink ID="lnkRegister" runat="server" NavigateUrl="~/Register.aspx"
                                    CssClass="inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
                                    Register Now
                                </asp:HyperLink>
                                <asp:HyperLink ID="lnkPublicDashboard" runat="server" Visible="false"
                                    CssClass="inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2 inline-block align-middle"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605"/></svg>Dashboard
                                </asp:HyperLink>
                                <asp:LinkButton ID="lnkPublicLogout" runat="server" Visible="false" OnClick="lnkLogout_Click" CausesValidation="false"
                                    CssClass="hidden sm:inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-gray-700 bg-white hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 mr-2 inline-block align-middle"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75"/></svg>Logout
                                </asp:LinkButton>
                                <button type="button" id="btnPublicMenu" onclick="togglePublicMenu()" aria-label="Toggle menu"
                                    class="md:hidden flex items-center justify-center size-10 rounded-md text-gray-700 hover:bg-gray-100 transition-colors">
                                    <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
                                </button>
                            </div>
                        </div>
                        <div id="publicMobileNav" class="hidden md:hidden pb-3 px-4 pt-2 flex flex-col gap-1 text-sm font-medium border-t border-gray-200">
                            <asp:Repeater ID="rptPublicMobileNav" runat="server" OnItemDataBound="rptPublicNav_ItemDataBound">
                                <ItemTemplate>
                                    <a id="publicMobileNavLink" runat="server" href='<%# Eval("Url") %>'
                                       class="px-3 py-2 rounded-md text-gray-700 hover:text-blue-600 transition-colors"><%# Eval("Text") %></a>
                                </ItemTemplate>
                            </asp:Repeater>
                            <asp:HyperLink ID="lnkMobileLogin" runat="server" NavigateUrl="~/Login.aspx"
                                CssClass="mt-1 inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-gray-700 hover:bg-gray-100 rounded-lg border border-gray-200 transition-colors">
                                Login
                            </asp:HyperLink>
                            <asp:LinkButton ID="lnkMobileLogout" runat="server" Visible="false" OnClick="lnkLogout_Click" CausesValidation="false"
                                CssClass="mt-1 inline-flex items-center justify-center h-10 px-4 text-sm font-semibold text-red-600 hover:bg-red-50 rounded-lg border border-red-200 transition-colors">
                                Logout
                            </asp:LinkButton>
                        </div>
                    </div>
                </nav>
            </asp:Panel>

            <%-- Application shell: sidebar plus content, for signed-in pages --%>
            <%-- flex-1 rather than min-h-screen: appShell is min-h-screen on a public page,
                 so the row takes the space that is actually left and the footer follows it
                 straight away. Pinned to min-h-screen it claimed a whole viewport on top
                 of the public header and pushed the footer off the first screen. --%>
            <div class="flex flex-1 min-h-0">
                <asp:Panel ID="pnlSidebar" runat="server" Visible="false">
                    <aside id="sideNav" class="relative shrink-0 bg-white border-r border-gray-200 flex flex-col h-screen transition-all duration-300 ease-in-out">
                        <%-- Brand block. Fixed height so the rail does not change size when a
                             role's panel title changes length. --%>
                        <div class="side-head px-4 h-16 border-b border-gray-200 flex items-center">
                            <div class="flex items-center gap-2.5 overflow-hidden">
                                <img src="<%= ResolveUrl("~/Images/logo.jpeg") %>" alt="TripWay logo" class="size-10 rounded-xl object-contain shrink-0" />
                                <div class="side-brand-text min-w-0">
                                    <p class="text-[15px] font-bold text-gray-900 leading-tight">TripWay</p>
                                    <p class="text-[11px] text-gray-400 leading-tight">Transport Platform</p>
                                </div>
                            </div>
                        </div>

                        <button id="btnSideToggle" type="button" aria-label="Collapse sidebar" aria-expanded="true"
                            class="absolute top-5 -right-3 z-50 flex items-center justify-center size-7 rounded-full border border-gray-200 bg-white text-gray-400 hover:bg-gray-100 hover:text-gray-600 shadow-sm transition-colors duration-150">
                            <%= TripWay.Helper.Heroicons.SvgFromName("arrow-left", "side-toggle-expanded size-3.5") %>
                            <%= TripWay.Helper.Heroicons.SvgFromName("arrow-right", "side-toggle-collapsed size-3.5") %>
                        </button>

                        <nav class="flex-1 py-3 overflow-y-auto overflow-x-hidden">
                            <p class="side-title px-4 mb-2 text-[11px] font-semibold uppercase tracking-wider text-gray-400"><asp:Literal ID="litSidebarTitle" runat="server" /></p>
                            <ul class="flex flex-col gap-1">
                                <asp:Repeater ID="rptSidebarLinks" runat="server" OnItemDataBound="rptSidebarLinks_ItemDataBound">
                                    <ItemTemplate>
                                        <li>
                                            <a id="navLink" runat="server" href='<%# Eval("Url") %>'
                                                class="nav-item flex items-center gap-3 py-2.5 px-4 text-[13px] font-medium rounded-lg transition-colors duration-150">
                                                <%# TripWay.Helper.Heroicons.SvgFromName(Eval("Icon").ToString(), "size-4") %>
                                                <span class="nav-label leading-tight"><%# Eval("Text") %></span>
                                                <%-- Red pill with white text for the pending count. It carries
                                                     nav-label so the collapsed rail hides it rather than
                                                     squeezing a number into a 4rem column. --%>
                                                <span id="navBadge" runat="server" visible="false"
                                                    class="nav-label ml-auto min-w-5 h-5 px-1.5 rounded-full bg-red-500 text-white text-[11px] font-bold flex items-center justify-center leading-none"></span>
                                            </a>
                                        </li>
                                    </ItemTemplate>
                                </asp:Repeater>
                            </ul>
                        </nav>

                        <div class="border-t border-gray-200 p-3 pt-2 space-y-1">
                            <a href="<%= ResolveUrl("~/Default.aspx") %>"
                                class="lnk-logout flex items-center gap-3 w-full py-2.5 px-4 text-[13px] font-medium text-gray-500 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors duration-150">
                                <%= TripWay.Helper.Heroicons.SvgFromName("globe", "size-4") %>
                                <span class="nav-label">View Public Site</span>
                            </a>
                            <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CausesValidation="false"
                                CssClass="lnk-logout flex items-center gap-3 w-full py-2.5 px-4 text-[13px] font-medium text-gray-500 hover:bg-red-50 hover:text-red-600 rounded-lg transition-colors duration-150"
                                ToolTip="Logout">
                                <%= TripWay.Helper.Heroicons.SvgFromName("logout", "size-4") %>
                                <span class="nav-label">Logout</span>
                            </asp:LinkButton>
                        </div>
                    </aside>
                </asp:Panel>

                <div class="flex min-w-0 flex-1 flex-col">
                    <asp:Panel ID="pnlAppHeader" runat="server" Visible="false">
                        <%-- The trail lives in the header rather than above the content, so the two
                             read as one bar. It follows the same visibility rule as this panel. --%>
                        <header class="shrink-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between gap-4">
                            <nav aria-label="breadcrumb">
                                <asp:Panel ID="pnlBreadcrumb" runat="server">
                                    <%-- Site.master.cs fills litBreadcrumb with its own <ol> and
                                         <li> crumbs, so nothing wraps it here. Pages that want
                                         their own trail override BreadcrumbContent instead. --%>
                                    <asp:ContentPlaceHolder ID="BreadcrumbContent" runat="server">
                                        <asp:Literal ID="litBreadcrumb" runat="server" />
                                    </asp:ContentPlaceHolder>
                                </asp:Panel>
                            </nav>
                            <div class="flex items-center gap-3">
                                <%-- The mobile login and log out buttons live in the public header's
                                     mobile menu. This panel and pnlPublicHeader can never both render,
                                     since one wants a signed in visitor on a private page and the other
                                     wants a public page or a signed out one, so the move cannot put
                                     two controls with the same ID on the page. --%>
                                <div class="hidden sm:flex items-center border border-gray-200 rounded-lg overflow-hidden">
                                    <button type="button" onclick="history.back()" aria-label="Go back"
                                        class="size-7 flex items-center justify-center text-gray-500 hover:bg-gray-100 transition-colors border-r border-gray-200">
                                        <%= TripWay.Helper.Heroicons.SvgFromName("arrow-left", "size-3.5") %>
                                    </button>
                                    <button type="button" onclick="history.forward()" aria-label="Go forward"
                                        class="size-7 flex items-center justify-center text-gray-500 hover:bg-gray-100 transition-colors">
                                        <%= TripWay.Helper.Heroicons.SvgFromName("arrow-right", "size-3.5") %>
                                    </button>
                                </div>
                                <asp:Literal ID="litUserInfo" runat="server" />
                            </div>
                        </header>
                    </asp:Panel>

                    <main id="mainContentArea" runat="server" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 sm:px-6">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                    </main>
                </div>
            </div>

            <%-- Public footer, laid out as three columns to match the JobConnect footer. It sits
                 directly under appShell rather than inside the content column, so it spans
                 the full page width and lands right after the content. Nested inside that
                 column it was pushed past the column's min-h-screen, a whole viewport of
                 blank space below the public header, which is why it read as missing.
                 Visibility still follows the public header, so the dashboard never shows it. --%>
            <asp:Panel ID="pnlFooter" runat="server" Visible="false">
                <footer class="bg-white text-gray-500 border-t border-gray-200">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div>
                            <div class="flex items-center gap-2.5 mb-3">
                                <img src="<%= ResolveUrl("~/Images/logo.jpeg") %>" alt="TripWay logo" class="size-9 rounded-xl object-contain shrink-0" />
                                <span class="font-bold text-gray-900 text-sm">TripWay</span>
                            </div>
                            <p class="text-sm leading-relaxed">A transport platform connecting riders with verified drivers &mdash; with modern tools for booking trips, tracking rides and managing fares.</p>
                        </div>
                        <div>
                            <h4 class="text-gray-900 font-bold mb-3 text-sm">Quick Links</h4>
                            <ul class="space-y-2 text-sm">
                                <li><a class="hover:text-blue-600" href="<%= ResolveUrl("~/Default.aspx") %>">Home</a></li>
                                <li><a class="hover:text-blue-600" href="<%= ResolveUrl("~/Services.aspx") %>">Services</a></li>
                                <li><a class="hover:text-blue-600" href="<%= ResolveUrl("~/FAQs.aspx") %>">FAQs</a></li>
                                <li><a class="hover:text-blue-600" href="<%= ResolveUrl("~/AboutUs.aspx") %>">About Us</a></li>
                                <li><a class="hover:text-blue-600" href="<%= ResolveUrl("~/ContactUs.aspx") %>">Contact</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-gray-900 font-bold mb-3 text-sm">Contact</h4>
                            <ul class="space-y-2 text-sm">
                                <li><span class="font-semibold text-gray-900">Address:</span> Market Zone, Hpa-An Township, Kayin State, Myanmar</li>
                                <li><span class="font-semibold text-gray-900">Phone:</span> +95 9 123 456 789</li>
                                <li><span class="font-semibold text-gray-900">Email:</span> support@tripway.com</li>
                            </ul>
                        </div>
                    </div>
                    <div class="border-t border-gray-200 py-4 text-center text-xs text-gray-400">
                        &copy; 2026 TripWay. All rights reserved.
                    </div>
                </footer>
            </asp:Panel>
        </div>

        <%-- One lightbox for the whole app. Panels are moved in and out of it, never cloned,
             so the server controls inside keep their postback wiring. --%>
        <div id="appModal" class="fixed inset-0 z-[1000] hidden items-start justify-center overflow-y-auto bg-black/50 p-4 md:p-8">
            <div id="appModalCard" class="relative w-full max-w-4xl rounded-2xl bg-white">
                <button type="button" id="appModalClose" class="tw-lb-close" aria-label="Close" title="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                    </button>
                <div id="appModalPanel" class="relative w-full max-w-4xl">
                    <div id="appModalBody" class="p-6"></div>
                </div>
            </div>
        </div>
    </form>

    <%-- Version query keyed off the file's own timestamp: busts the browser cache when the
         file changes, stays cached when it does not. Without it a stale tw-toast.js keeps
         serving the old behaviour and the pages look unfixed. --%>
    <script src="<%= ResolveUrl("~/Scripts/tw-toast.js") %>?v=<%= System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/tw-toast.js")).Ticks %>"></script>
    <script src="<%= ResolveUrl("~/Scripts/tw-upload.js") %>"></script>
    <script src="<%= ResolveUrl("~/Scripts/tw-eta.js") %>"></script>
    <script src="<%= ResolveUrl("~/Scripts/tripway-scroll.js") %>"></script>
    <script>
        // ---- collapsible app sidebar -------------------------------------------
        // Narrows the rail to an icon-only column rather than hiding it, so the nav
        // stays reachable at every width. The choice is remembered per browser.
        //
        // The click is bound here instead of through an onclick attribute, and the glyph
        // is swapped in CSS off the same class, so no markup is ever built inside script.
        // Those two were why the toggle did nothing: the icon markup used to be dropped
        // into a single quoted string literal, but SvgFromName writes its attributes with
        // single quotes too, so the string ended early and the whole script block failed
        // to parse, leaving every function in it undefined.
        function setSidebarCollapsed(s, btn, collapsed) {
            s.classList.toggle('tw-collapsed', collapsed);
            if (btn) {
                btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                btn.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
            }
            try { localStorage.setItem('tw-side', collapsed ? '1' : '0'); } catch (e) { }
        }

        function toggleSidebar() {
            var s = document.getElementById('sideNav');
            if (!s) return;
            setSidebarCollapsed(s, document.getElementById('btnSideToggle'),
                !s.classList.contains('tw-collapsed'));
        }

        // ---- public header mobile menu ------------------------------------------
        function togglePublicMenu() {
            var m = document.getElementById('publicMobileNav');
            if (m) m.classList.toggle('hidden');
        }

        document.addEventListener('DOMContentLoaded', function () {
            var s = document.getElementById('sideNav');
            if (!s) return;
            var btn = document.getElementById('btnSideToggle');
            if (btn) {
                btn.addEventListener('click', function () { toggleSidebar(); });
            }

            var collapsed = false;
            try { collapsed = localStorage.getItem('tw-side') === '1'; } catch (e) { }
            // Never start collapsed on a narrow screen: the rail plus the content
            // has to leave the page usable on a phone.
            if (collapsed && window.innerWidth >= 640) {
                setSidebarCollapsed(s, btn, true);
            }
        });

        // Every width appOpenModal knows how to swap. Anything a page asks for has to be in here,
        // otherwise two max-w-* classes can end up on the panel at once.
        function appOpenModal(html, widthClass) {
            var widths = ['max-w-4xl', 'max-w-3xl', 'max-w-2xl', 'max-w-xl', 'max-w-lg', 'max-w-md', 'max-w-sm', 'max-w-xs'];
            var modal = document.getElementById('appModal');
            var card = document.getElementById('appModalCard');
            var panel = document.getElementById('appModalPanel');
            var body = document.getElementById('appModalBody');
            if (!modal || !card || !panel || !body) return;

            // Every other overlay is a card. Clearing the class here means the image view's
            // own rules cannot outlive it and leave the next panel framed differently.
            modal.classList.remove('tw-modal-image');

            /* Both the card and the panel, not just the panel. The card is what the eye reads
               as the size of the dialog, and it used to hold a fixed max-w-4xl that nothing
               could swap, so a narrower panel sat left-aligned inside a wider white card with
               a dead gutter down one side. */
            for (var i = 0; i < widths.length; i++) {
                panel.classList.remove(widths[i]);
                card.classList.remove(widths[i]);
            }
            var width = widthClass || 'max-w-4xl';
            panel.classList.add(width);
            card.classList.add(width);

            // null means "whatever is already in here stays", which is how a moved form survives.
            if (html !== null && html !== undefined) body.innerHTML = html;

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        // Move a server panel into the lightbox. It has to be the same node, not a copy: the
        // inputs inside keep their ctl$ names and post back normally.
        function appOpenPanel(panelId, widthClass) {
            var p = document.getElementById(panelId);
            if (!p) return;
            var b = document.getElementById('appModalBody');
            if (!b) return;

            p.setAttribute('data-tw-panel', '1');
            p.setAttribute('data-tw-home', p.parentNode ? p.parentNode.id : '');

            while (b.firstChild) b.removeChild(b.firstChild);
            b.appendChild(p);
            p.classList.remove('tw-panel-parked');

            appOpenModal(null, widthClass);
        }

        function appCloseModal() {
            var modal = document.getElementById('appModal');
            var b = document.getElementById('appModalBody');
            var p = b ? b.querySelector('[data-tw-panel]') : null;

            if (p) {
                var home = document.getElementById(p.getAttribute('data-tw-home'));
                if (home) {
                    home.appendChild(p);
                    p.classList.add('tw-panel-parked');
                }
            }

            if (modal) {
                modal.classList.remove('tw-modal-image');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
            document.body.style.overflow = '';
        }

        // Wiring is done with named handlers rather than an inline closure: the functions above
        // are read out of this file by name, and an enclosing function would cut them short.
        function appModalBackdrop(e) {
            var modal = document.getElementById('appModal');
            if (modal && e.target === modal) appCloseModal();
        }

        function appModalEscape(e) {
            if (e.key === 'Escape') appCloseModal();
        }

        // ---- image lightbox ---------------------------------------------------
        // The same overlay card every other panel uses, sized down to max-w-sm, with no
        // heading: just the picture in a small frame. Esc, the backdrop and the close button all
        // still work, because those are the shell's, not this one's.
        //
        // Markup is built here instead of in a page so a page only has to carry the
        // data-doc-* attributes, and so the values are set as text or as an attribute
        // rather than pasted into markup: a filename is user-supplied and an apostrophe
        // in it would otherwise end the string and take the rest of the script with it.
        function appOpenImage(src, label, name, isPdf) {
            if (!src) return;

            var body = document.getElementById('appModalBody');
            if (!body) return;

            // appOpenModal is called with null further down, which leaves the body alone so a
            // moved form survives. That means anything left from a previous view would stay
            // underneath this one, so the body is emptied here instead.
            while (body.firstChild) body.removeChild(body.firstChild);

            // A PDF is served through ViewFile.ashx as an inline stream, so it belongs in
            // an iframe: an <img> would render nothing at all.
            var view = isPdf
                ? document.createElement('iframe')
                : document.createElement('img');
            if (isPdf) {
                // A document needs a height of its own to scroll inside, so it gets one that
                // leaves the backdrop and the card's own edges visible around it.
                view.className = 'block h-[70vh] w-full border-0';
                view.setAttribute('title', name || label || 'Document');
            } else {
                // Sized to the picture and capped rather than stretched to fill the card: a
                // phone photo is far larger than any screen, so this shows all of it at once,
                // and the empty space beside it still belongs to the card, so clicking away
                // from the picture keeps closing the viewer. Stretching a low resolution photo
                // across the frame would only make it harder to read, and letting a tall one
                // run to its natural height would stretch the card down the page.
                view.className = 'block h-auto w-auto max-h-[70vh] max-w-full object-contain';
                view.alt = name || label || 'Document';
            }
            view.src = src;
            body.appendChild(view);

            // max-w-sm, half of the max-w-2xl it was before. The card is deliberately narrow
            // now, so the picture keeps its own proportions inside a small frame instead of
            // sitting in a wide empty one.
            appOpenModal(null, 'max-w-sm');

            // Added after the open, because opening an overlay clears the class for the
            // card-shaped ones and this is the only one that wants the image-specific rules.
            var modal = document.getElementById('appModal');
            if (modal) modal.classList.add('tw-modal-image');
        }

        // Delegated, so a document inside a repeater needs no onclick of its own. The
        // listener lives on the document rather than on the tile because the tiles are
        // re-rendered on every postback and would lose a directly-bound handler.
        function appOpenDocumentClick(e) {
            var t = e.target;
            var node = t && t.closest ? t.closest('[data-doc-src]') : null;
            if (!node) return;

            // A control inside the tile (a link, a button meant for something else) keeps
            // its own behaviour; only the plain tile opens the viewer.
            if (t.closest('a[href]')) return;

            e.preventDefault();
            appOpenImage(
                node.getAttribute('data-doc-src'),
                node.getAttribute('data-doc-label'),
                node.getAttribute('data-doc-name'),
                node.getAttribute('data-doc-pdf') === '1');
        }

        (function () {
            var close = document.getElementById('appModalClose');
            if (close) close.addEventListener('click', appCloseModal);
            var modal = document.getElementById('appModal');
            if (modal) modal.addEventListener('click', appModalBackdrop);
            document.addEventListener('keydown', appModalEscape);
            document.addEventListener('click', appOpenDocumentClick);
        })();
    </script>
</body>
</html>